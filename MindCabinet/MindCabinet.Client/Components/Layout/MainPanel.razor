@using Microsoft.AspNetCore.Components;
@using MindCabinet.Client.Components.Application.RichEditors;
@using MindCabinet.Client.Components.Application;
@using MindCabinet.Client.Components.Application.Editors;
@using MindCabinet.Client.Components.Application.Pickers;
@using MindCabinet.Client.Components.Application.Renders;
@using MindCabinet.Client.Components.Standard;
@using MindCabinet.Client.Components.Standard.Tabs;
@using MindCabinet.Client.Services;
@using MindCabinet.Shared.DataObjects;


<div component-name="@nameof(MainPanel)" class=@this.AddedClasses>
    <Tabs Id=@this.TabsId>
        <TabEntry Id=@this.PostsTabId>
            <Header>
                <h4>Posts</h4>
            </Header>
            <Content>
                @if( this.MySessionMngr.UserName is not null ) {
                    <CurrentPostsRichEditor />
                } else {
                    <span>...</span>
                }
            </Content>
        </TabEntry>
        <TabEntry Id=@this.TagsTabId>
            <Header>
                <h4>Tags</h4>
            </Header>
            <Content>
                @if( this.MySessionMngr.UserName is not null ) {
                    <TermsEditorSuite />
                } else {
                    <span>...</span>
                }
            </Content>
        </TabEntry>
    </Tabs>
</div>



@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = null!;


    public string TabsId => $"{this.Id}Tabs";
    public string PostsTabId => $"{this.Id}PostsTab";
    public string TagsTabId => $"{this.Id}TagsTab";
}
