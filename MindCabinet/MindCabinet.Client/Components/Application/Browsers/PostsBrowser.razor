@using System.Text.Json;
@using Microsoft.AspNetCore.Components;
@using MindCabinet.Client.Components.Application.Editors;
@using MindCabinet.Client.Components.Application.Renders;
@using MindCabinet.Client.Components.Standard;
@using MindCabinet.Client.Services;
@using MindCabinet.Shared.DataObjects;
@using MindCabinet.Shared.DataObjects.Term;



<div component-name="@nameof(PostsBrowser)" class=@this.AddedClasses>
    <div style="display: grid; grid-template-columns: auto auto;">
        <div>
            <span>Sort by date: </span>
            @{
                <input type="radio" name=@this.SortName id=@this.SortAscendingId
                        @onchange=@( async (e) => await this.SetCreateDateSort_UI_Async(true) ) />
                    <label for=@this.SortAscendingId>Ascending</label>
                <input type="radio" name=@this.SortName id=@this.SortDescendingId checked
                        @onchange=@( async (e) => await this.SetCreateDateSort_UI_Async(false) ) />
                    <label for=@this.SortDescendingId>Descending</label>
            }
        </div>
        <div style="margin-left: auto; margin-right: 0;">
            <span>Search</span>
            <input type="text"
					    placeholder="Enter search"
                        @onchange=@this.SetBodySearch_UI_Async />
        </div>
    </div>
    
    <MultiSimplePostRender Posts=@this.CurrentPagePosts_Cache />
    
    <div style="display: grid; grid-template-columns: auto auto;">
        <Pagination CurrentPage=@this.PostsSupply.GetCurrentPage()
                    TotalPages=@this.TotalPages_Cache
                    OnPageChange_Async=@this.ChangePage_UI_Async />
        <div style="margin-left: auto; margin-right: 0;">
            <span>Filter by tags</span>
            <TermSetInputEditor
                    VerboseTermDisplay=@false
                    AddedClasses="ib"
                    OnTermsChange_Async=@this.SetFilterTags_UI_Async />
        </div>
    </div>
</div>



@code {
    private string SortName => "sort_by_create_date_"+this.Id;
    private string SortAscendingId => "sort_by_create_date_asc_"+this.Id;
    private string SortDescendingId => "sort_by_create_date_desc_"+this.Id;


    
    private async Task SetFilterTags_UI_Async( IEnumerable<TermObject> tags, TermObject tag, bool isAdded ) {
//ConsoleermriteLine( "tags changed: "+JsonSerializer.Serialize(tags)+", tag: "+tag.ToString()+", isAdded: "+isAdded );
        await this.SetFilterTags_Async( tags );
    }

    private async Task SetBodySearch_UI_Async( ChangeEventArgs args ) {
        await this.SetBodySearch_Async( args.Value?.ToString() ?? "" );
    }

    private async Task ChangePage_UI_Async( int page ) {
        await this.ChangePage_Async( page );
    }

    private async Task SetCreateDateSort_UI_Async( bool isAscending ) {
        await this.SetCreateDateSort_Async( isAscending );
    }
    
    private async Task<IEnumerable<SimplePostObject>> GetPostsOfCurrentPage_UI_Async() {
        return await this.GetPostsOfCurrentPage_Async();
    }
}