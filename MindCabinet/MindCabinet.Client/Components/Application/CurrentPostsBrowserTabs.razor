@using System.Text.Json;
@using System.Text.RegularExpressions;
@using Microsoft.AspNetCore.Components;
@using MindCabinet.Client.Components.Application.Browsers;
@using MindCabinet.Client.Components.Application.Editors;
@using MindCabinet.Client.Components.Standard.Tabs;
@using MindCabinet.Client.Services;
@using MindCabinet.Client.Services.DataPresenters;
@using MindCabinet.Shared.DataObjects;
@using MindCabinet.Shared.DataObjects.PostsQuery
@using MindCabinet.Shared.DataObjects.Term;
@using MindCabinet.Shared.Utility



<div component-name=@nameof(CurrentPostsBrowserTabs) class=@this.AddedClasses>
    <Tabs @ref=@this.Tabs Id=@this.Id>
        @{
            this._PostsBrowsersByTabIndex.Clear();

            for( int i=0; i<(this.Suppliers_Cache?.Count() ?? 0); i++ ) {
                PostsSupplier supply = this.Suppliers_Cache![i];
                PostsQueryObject query = supply.GetPostsQuery();
                string browserId = $"{this.Id}_{query.Id}";

                <TabEntry Id="@this.GetTabId(query.Name)">
                    <Header>
                        <div>'@(query.Name)' posts</div>
                    </Header>
                    <Content>
                        <PostsBrowser
                            @ref=@this._TempPostsBrowserRef
                            Id=@browserId
                            PostsSupply=supply />
                    </Content>
                </TabEntry>

                this._PostsBrowsersByTabIndex.Add( this._TempPostsBrowserRef! );
            }
        }
    </Tabs>
</div>



@code {
    private PostsBrowser? _TempPostsBrowserRef;    // yuck!



    public string GetTabId( string queryName ) {
        return this.Id + "_" + queryName.ToId();
    }
}
